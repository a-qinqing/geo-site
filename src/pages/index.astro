---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import JsonLDSchema from "@components/JsonLDSchema.astro";

const posts = await getCollection("blog");
const latestPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// ===== JSON-LD 结构化数据 =====
const siteURL = Astro.site?.origin || "https://www.geova.cn/";

// Person 实体
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "GEO 咨询顾问",
  url: siteURL,
  jobTitle: "SEO & GEO 策略顾问",
  description: "专注于 SEO 与 GEO（生成式引擎优化）策略，10+ 年搜索优化经验，帮助企业与个人在 AI 时代重构搜索流量。",
  sameAs: [
    "https://twitter.com/q1404929834",
    "https://www.linkedin.com/in/geova-qin/",
  ],
  knowsAbout: [
    "Search Engine Optimization",
    "Generative Engine Optimization",
    "AI Search Visibility",
    "Structured Data",
    "Content Strategy",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: "contact@geova.cn",
    availableLanguage: ["zh-CN", "en"],
  },
};

// ProfessionalService 实体
const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "GEO 咨询 — SEO & GEO 搜索优化服务",
  url: siteURL,
  description: "提供 SEO 全站诊断、GEO/AI 搜索可见度优化、团队顾问与培训三大核心服务。从诊断到执行，覆盖搜索流量全链路。",
  provider: {
    "@type": "Person",
    name: "GEO 咨询顾问",
  },
  areaServed: {
    "@type": "Continent",
    name: "全球（线上服务）",
  },
  availableChannel: {
    "@type": "ServiceChannel",
    serviceUrl: `${siteURL}/contact`,
    availableLanguage: ["zh-CN", "en"],
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "核心服务",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "SEO 全站诊断",
          url: `${siteURL}/services/seo-audit/`,
          description: "系统诊断网站技术健康度、内容质量和外链状况，交付可落地的优化路线图。",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "GEO / AI 搜索可见度优化",
          url: `${siteURL}/services/geo-optimization/`,
          description: "提升品牌在 ChatGPT、Perplexity、Gemini 等 AI 引擎中的被引用率与可见度。",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "团队顾问与培训",
          url: `${siteURL}/services/training/`,
          description: "为企业市场团队提供 SEO + GEO 能力建设，从认知培训到策略陪跑。",
        },
      },
    ],
  },
};

// WebSite 实体（含 SearchAction）
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "GEO 咨询",
  url: siteURL,
  description: "专注 SEO & GEO 优化，帮企业与个人重构搜索流量。提供搜索策略知识分享与专业咨询服务。",
  inLanguage: "zh-CN",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteURL}/search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

// Organization 实体
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "GEO 咨询",
  url: siteURL,
  description: "专注 SEO 与 GEO（生成式引擎优化）策略的知识分享与咨询服务",
  email: "contact@geova.cn",
  founder: {
    "@type": "Person",
    name: "GEO 咨询顾问",
  },
  sameAs: [
    "https://twitter.com/q1404929834",
    "https://www.linkedin.com/in/geova-qin/",
  ],
};
---

<Layout
  title="GEO 咨询 | 专注 SEO & GEO 优化，帮企业与个人重构搜索流量"
  description="专注 SEO 与 GEO（生成式引擎优化）策略，为企业和个人提供搜索流量重构方案。预约免费 15 分钟咨询，开启 AI 时代的搜索可见度升级。"
>
<meta name="baidu-site-verification" content="codeva-XfHJ65VQAj" />
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white">
    <!-- 装饰背景 -->
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-20 left-10 w-72 h-72 bg-blue-500 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-emerald-500 rounded-full blur-3xl"></div>
    </div>
    <!-- 网格纹理 -->
    <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] bg-[length:40px_40px]"></div>

    <div class="relative container-page py-24 md:py-32">
      <div class="max-w-3xl">
        <!-- 标签 -->
        <span class="inline-block px-4 py-1.5 bg-blue-600/30 text-blue-200 rounded-full text-sm font-medium mb-6 border border-blue-500/30 backdrop-blur-sm">
          🚀 AI 时代的搜索流量重构
        </span>

        <!-- 主标题 -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 text-white">
          专注 SEO & GEO 优化<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
            帮企业与个人重构搜索流量
          </span>
        </h1>

        <!-- 副标题 -->
        <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-4 max-w-2xl">
          在 ChatGPT、Perplexity、Google AI Overviews 主导的新搜索时代，
          传统关键词排名已不足以保障流量增长。
        </p>
        <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-10 max-w-2xl">
          我帮助客户打通 <strong class="text-white">SEO 技术优化</strong> + <strong class="text-white">GEO 生成式引擎可见度</strong> 的全链路，
          让品牌在 AI 答案中被发现、被引用、被信任。
        </p>

        <!-- CTA 按钮 -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all duration-200 no-underline text-lg shadow-lg shadow-blue-600/25 hover:shadow-blue-600/40"
          >
            📅 预约免费 15 分钟咨询
          </a>
          <a
            href="/services"
            class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl border border-white/20 transition-all duration-200 no-underline backdrop-blur-sm"
          >
            了解服务详情
            <span class="ml-2">→</span>
          </a>
        </div>

        <!-- 社会证明 -->
        <div class="flex flex-wrap items-center gap-6 mt-12 text-sm text-slate-400">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> 10+ 年 SEO 实战经验
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> AI 搜索可见度专项研究
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> 为企业与个人提供定制方案
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 三大核心服务 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 区域标题 -->
      <div class="text-center mb-16">
        <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">核心服务</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">
          三大核心服务
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          从诊断到执行，覆盖 SEO + GEO 全链路的专业服务，帮助你在 AI 搜索时代持续获得高质量流量。
        </p>
      </div>

      <!-- 服务卡片 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- 服务 1: SEO 全站诊断 -->
        <div class="group relative p-8 rounded-2xl border border-slate-200 hover:border-blue-300 hover:shadow-xl transition-all duration-300 bg-white">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition-transform duration-300">
            🔍
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">SEO 全站诊断</h3>
          <p class="text-slate-600 leading-relaxed mb-6">
            系统诊断网站的技术健康度、内容质量和外链状况。基于真实数据找出流量瓶颈，交付可落地的优化路线图。
          </p>
          <ul class="space-y-2 text-sm text-slate-500 border-t border-slate-100 pt-4">
            <li class="flex items-start gap-2">
              <span class="text-blue-500 mt-0.5">•</span> 技术 SEO 审计（爬虫、索引、性能）
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-500 mt-0.5">•</span> 内容质量与关键词覆盖分析
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-500 mt-0.5">•</span> 竞品对标与流量机会挖掘
            </li>
          </ul>
          <a href="/services/seo-audit/" class="inline-flex items-center mt-6 text-blue-600 hover:text-blue-800 font-medium text-sm no-underline group-hover:gap-1 transition-all">
            了解更多 <span class="ml-1 group-hover:ml-2 transition-all">→</span>
          </a>
        </div>

        <!-- 服务 2: GEO/AI 搜索可见度优化 -->
        <div class="group relative p-8 rounded-2xl border border-slate-200 hover:border-emerald-300 hover:shadow-xl transition-all duration-300 bg-white">
          <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition-transform duration-300">
            🤖
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">GEO / AI 搜索可见度优化</h3>
          <p class="text-slate-600 leading-relaxed mb-6">
            提升品牌在 ChatGPT、Perplexity、Gemini 等 AI 引擎中的被引用率。通过结构化数据、知识图谱和 AI 友好内容策略建立品牌权威。
          </p>
          <ul class="space-y-2 text-sm text-slate-500 border-t border-slate-100 pt-4">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 mt-0.5">•</span> AI 引擎品牌引用现状评估
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 mt-0.5">•</span> 结构化数据 & 知识图谱部署
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 mt-0.5">•</span> AI 友好内容策略与权威建设
            </li>
          </ul>
          <a href="/services/geo-optimization/" class="inline-flex items-center mt-6 text-emerald-600 hover:text-emerald-800 font-medium text-sm no-underline group-hover:gap-1 transition-all">
            了解更多 <span class="ml-1 group-hover:ml-2 transition-all">→</span>
          </a>
        </div>

        <!-- 服务 3: 团队顾问与培训 -->
        <div class="group relative p-8 rounded-2xl border border-slate-200 hover:border-amber-300 hover:shadow-xl transition-all duration-300 bg-white">
          <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-6 text-3xl group-hover:scale-110 transition-transform duration-300">
            🎓
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">团队顾问与培训</h3>
          <p class="text-slate-600 leading-relaxed mb-6">
            为企业市场团队提供 SEO + GEO 能力建设。从认知培训到策略陪跑，帮助团队建立可持续的搜索优化体系。
          </p>
          <ul class="space-y-2 text-sm text-slate-500 border-t border-slate-100 pt-4">
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">•</span> 企业内训：SEO/GEO 认知与实操
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">•</span> 1v1 策略咨询与季度复盘
            </li>
            <li class="flex items-start gap-2">
              <span class="text-amber-500 mt-0.5">•</span> 工作流搭建与工具链配置
            </li>
          </ul>
          <a href="/services/training/" class="inline-flex items-center mt-6 text-amber-600 hover:text-amber-800 font-medium text-sm no-underline group-hover:gap-1 transition-all">
            了解更多 <span class="ml-1 group-hover:ml-2 transition-all">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新干货文章 -->
  <section class="py-20 md:py-28 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">干货分享</span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2">
            最新干货文章
          </h2>
          <p class="text-slate-600 mt-2">SEO 与 GEO 的前沿知识、策略指南和实战案例</p>
        </div>
        <a
          href="/blog"
          class="hidden sm:inline-flex items-center text-blue-600 hover:text-blue-800 font-medium no-underline transition-colors"
        >
          查看全部文章 <span class="ml-1">→</span>
        </a>
      </div>

      {
        latestPosts.length === 0 ? (
          <div class="text-center py-16">
            <div class="text-5xl mb-4">📝</div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">文章正在路上</h3>
            <p class="text-slate-600">干货内容正在精心准备中，请稍后再来。</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {latestPosts.map((post) => (
              <article class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition-all duration-300">
                <div class="p-6">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-1 rounded-full">
                      {post.data.category || "GEO"}
                    </span>
                    <span class="text-xs text-slate-400">
                      {post.data.pubDate.toLocaleDateString("zh-CN", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </span>
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors leading-snug">
                    <a href={`/blog/${post.slug}`} class="no-underline text-inherit">
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="text-slate-600 text-sm leading-relaxed mb-4 line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-2">
                    {post.data.tags?.slice(0, 3).map((tag: string) => (
                      <span class="text-xs bg-slate-100 text-slate-500 px-2 py-0.5 rounded-md">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        )
      }

      <!-- 移动端查看全部 -->
      <div class="text-center mt-8 sm:hidden">
        <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium no-underline">
          查看全部文章 <span class="ml-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 md:py-28 bg-gradient-to-r from-blue-600 to-emerald-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-20 w-64 h-64 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-20 w-64 h-64 bg-white rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        准备好重构你的搜索流量了吗？
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        预约免费 15 分钟咨询，我会了解你的现状并给出初步优化方向——无需承诺，纯粹价值。
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-flex items-center px-8 py-4 bg-white text-blue-600 font-bold rounded-xl hover:bg-slate-100 transition-all duration-200 no-underline text-lg shadow-lg"
        >
          📅 预约免费 15 分钟咨询
        </a>
        <a
          href="/blog"
          class="inline-flex items-center px-8 py-4 bg-white/10 text-white font-semibold rounded-xl border border-white/20 hover:bg-white/20 transition-all duration-200 no-underline backdrop-blur-sm"
        >
          先看看干货文章
        </a>
      </div>
    </div>
  </section>

  <!-- JSON-LD 结构化数据 -->
  <JsonLDSchema data={personSchema} />
  <JsonLDSchema data={organizationSchema} />
  <JsonLDSchema data={professionalServiceSchema} />
  <JsonLDSchema data={webSiteSchema} />
</Layout>
