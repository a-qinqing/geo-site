---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import JsonLDSchema from "@components/JsonLDSchema.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import {
  SITE_URL,
  personSchema,
  organizationSchema,
  breadcrumbSchema as buildBreadcrumb,
} from "../../lib/schema-entities";

// output: "server" 模式下保持博客文章静态预渲染（保留 sitemap 收录与构建期生成）
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const articleURL = new URL(`/blog/${post.slug}`, SITE_URL).href;

// Article 结构化数据：
// - @type 由 frontmatter articleType 决定（默认 BlogPosting；structured-data-guide 为 TechArticle）
// - author 统一引用 /about 的真实 Person（#person）
// - publisher 统一引用 Organization 根实体（#organization），不再内联孤立副本
const articleSchema = {
  "@context": "https://schema.org",
  "@type": post.data.articleType ?? "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  url: articleURL,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.updatedDate
    ? new Date(post.data.updatedDate).toISOString()
    : post.data.pubDate.toISOString(),
  author: {
    "@type": "Person",
    "@id": personSchema["@id"],
    name: personSchema.name,
    url: personSchema.url,
  },
  publisher: {
    "@type": "Organization",
    "@id": organizationSchema["@id"],
    name: organizationSchema.name,
    url: organizationSchema.url,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleURL,
  },
  keywords: post.data.tags?.join(", ") || "",
  inLanguage: "zh-CN",
};

// 面包屑：可见 UI 与 BreadcrumbList JSON-LD 共用同一数据源
const breadcrumbItems = [
  { name: "首页", url: SITE_URL },
  { name: "博客", url: `${SITE_URL}/blog` },
  { name: post.data.title, url: articleURL },
];
const breadcrumbSchema = buildBreadcrumb(breadcrumbItems);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedDate={post.data.pubDate.toISOString()}
  modifiedDate={
    post.data.updatedDate
      ? new Date(post.data.updatedDate).toISOString()
      : post.data.pubDate.toISOString()
  }
  tags={post.data.tags || []}
  author={post.data.author || "GEO 咨询团队"}
>
  <!-- Article Header -->
  <section class="bg-gradient-to-r from-slate-900 to-blue-900 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-blue-300 uppercase tracking-wider bg-blue-600/30 px-3 py-1 rounded-full">
          {post.data.category || "GEO"}
        </span>
        <span class="text-sm text-slate-400">
          {post.data.pubDate.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4 text-white leading-tight">
        {post.data.title}
      </h1>
      <p class="text-lg text-slate-300">
        {post.data.description}
      </p>
      <div class="flex items-center gap-2 mt-6">
        {post.data.tags?.map((tag: string) => (
          <span class="text-xs bg-white/10 text-slate-300 px-3 py-1 rounded-full">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Article Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 可见面包屑（置于正文内容区顶部，不占用 Hero 首屏） -->
      <Breadcrumb items={breadcrumbItems} />
      <div class="prose prose-slate prose-lg max-w-none
        prose-headings:text-slate-900
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
        prose-p:text-slate-600 prose-p:leading-relaxed
        prose-a:text-blue-600 prose-a:no-underline hover:prose-a:text-blue-800
        prose-strong:text-slate-900
        prose-code:text-blue-600 prose-code:bg-slate-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-slate-900 prose-pre:text-slate-100
        prose-li:text-slate-600
        prose-img:rounded-xl prose-img:shadow-lg
      ">
        <Content />
      </div>

      <!-- Back to Blog -->
      <div class="mt-16 pt-8 border-t border-slate-200">
        <a href="/blog" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium no-underline">
          <span class="mr-2">←</span> 返回博客列表
        </a>
      </div>
    </div>
  </article>

  <!-- JSON-LD 结构化数据 -->
  <JsonLDSchema data={articleSchema} />
  <JsonLDSchema data={breadcrumbSchema} />
</Layout>
