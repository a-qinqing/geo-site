---
import Layout from "@layouts/Layout.astro";
import JsonLDSchema from "@components/JsonLDSchema.astro";

const siteURL = Astro.site?.origin || "https://www.geova.cn/";

// 服务列表（ItemList）
const services = [
  {
    id: "seo-audit",
    icon: "🔍",
    name: "SEO 全站诊断",
    url: `${siteURL}/services/seo-audit/`,
    color: "blue",
    tagline: "传统搜索流量停滞或下降？找到真正原因",
    summary:
      "人工 + 工具结合，四大维度（技术健康度 / 内容与关键词 / 外链与权威度 / 竞品对标）系统审计，交付分级问题清单与 3 个月执行路线图。",
    points: ["找到流量停滞的根本原因", "问题分级 + 修复优先级", "含竞品对标与执行路线图"],
  },
  {
    id: "geo-optimization",
    icon: "🤖",
    name: "GEO 优化服务",
    url: `${siteURL}/services/geo-optimization/`,
    color: "emerald",
    tagline: "让品牌在 AI 答案中被发现、被引用、被信任",
    summary:
      "从 AI 可见度基线评估、实体与结构化数据，到 AI 友好内容与品牌信号建设——系统提升品牌在 ChatGPT、Perplexity 等引擎中的可见度与引用率。",
    points: ["AI 引擎可见度基线 + 季度追踪", "实体 / 结构化数据落地", "AI 友好内容与引用优化"],
  },
  {
    id: "geo-audit",
    icon: "🩺",
    name: "GEO 审计与 AI 搜索诊断",
    url: `${siteURL}/services/geo-audit/`,
    color: "violet",
    tagline: "看清品牌在 AI 搜索中的真实可见度",
    summary:
      "多引擎 × 固定问题集实测品牌被提及、被引用、被推荐的真实情况，叠加竞品对标与实体审查，交付可复测的可见度基线与执行路线图。",
    points: ["ChatGPT / Perplexity / Gemini 实测", "竞品 AI 可见度对照", "3 个月执行路线图"],
  },
  {
    id: "training",
    icon: "🎓",
    name: "SEO/GEO 培训与团队顾问",
    url: `${siteURL}/services/training/`,
    color: "amber",
    tagline: "把搜索优化能力真正内建到团队",
    summary:
      "企业内训、1v1 策略咨询、搜索优化工作流搭建与季度复盘——从认知、方法到工具链，帮团队建立可持续的搜索优化体系。",
    points: ["定制化内训课程", "工作流 SOP 与工具链", "季度策略复盘可选"],
  },
];

// 场景选择
const scenarios = [
  {
    icon: "📉",
    title: "网站流量停滞或下降",
    desc: "传统搜索来的流量在跌，不知道问题出在技术、内容还是外链。",
    cta: "先做 SEO 全站诊断",
    url: "/services/seo-audit/",
  },
  {
    icon: "🤖",
    title: "客户问 AI 时看不到你的品牌",
    desc: "AI 引擎的答案里没有你，或总是推荐竞争对手。",
    cta: "先做 GEO 审计",
    url: "/services/geo-audit/",
  },
  {
    icon: "🚀",
    title: "已有可见度基础，想系统增长",
    desc: "知道自己在 AI 里的位置，希望进入持续优化阶段。",
    cta: "了解 GEO 优化服务",
    url: "/services/geo-optimization/",
  },
  {
    icon: "🎓",
    title: "想把能力沉淀在团队内部",
    desc: "不满足于外部执行，希望团队能自己判断、自己迭代。",
    cta: "了解培训与顾问",
    url: "/services/training/",
  },
];

// FAQ 结构化数据
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "我不确定该选哪个服务，怎么办？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "完全正常！大多数客户在开始时都不确定。建议你直接预约免费 15 分钟咨询，我会了解你的情况后给出最合适的服务建议——没有任何推销压力。",
      },
    },
    {
      "@type": "Question",
      name: "服务费用是多少？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "每个项目根据网站规模、需求深度和交付范围定价。初步沟通后我会提供明确的报价方案。所有项目报价透明，无隐藏费用。",
      },
    },
    {
      "@type": "Question",
      name: "多久能看到效果？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEO/GEO 是中长期策略，通常需要 2-6 个月才能看到显著效果。但诊断类服务可以立即交付——你在收到报告当天就能获得明确的优化方向。执行类服务通常在第 2-3 个月开始显现数据变化。",
      },
    },
  ],
};

// ItemList 结构化数据
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "SEO & GEO 专业服务",
  url: `${siteURL}/services/`,
  numberOfItems: services.length,
  itemListElement: services.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.name,
    url: s.url,
  })),
};

// BreadcrumbList 结构化数据
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: siteURL },
    { "@type": "ListItem", position: 2, name: "服务", item: `${siteURL}/services/` },
  ],
};
---

<Layout
  title="SEO & GEO 服务 | GEO 咨询"
  description="SEO 全站诊断、GEO 优化、GEO 审计与 AI 搜索诊断、团队培训顾问——从诊断到执行，覆盖传统搜索与 AI 搜索全链路。不清楚该选哪个？免费 15 分钟咨询帮你判断。"
>
  <!-- Page Header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-20 md:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-10 w-96 h-96 bg-blue-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-blue-600/30 text-blue-200 rounded-full text-sm font-medium mb-4 border border-blue-500/30 backdrop-blur-sm">
        📋 专业服务
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-white">SEO + GEO 专业服务</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        传统搜索与 AI 搜索正在融合。从诊断、审计到持续优化与团队能力建设——
        四个服务覆盖搜索流量的全链路。不知道从哪开始？往下看"如何选择"。
      </p>
    </div>
  </section>

  <!-- 服务导览 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">服务导览</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">四个服务，一条增长路径</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          每个服务都对应明确的搜索问题与商业目标——点进详情页看完整内容与交付物。
        </p>
      </div>

      <div class="space-y-6">
        {
          services.map((s) => (
            <div id={s.id} class={`rounded-2xl border p-8 scroll-mt-20 bg-white border-slate-200 hover:shadow-lg transition-all duration-300`}>
              <div class="flex flex-col lg:flex-row gap-6 items-start lg:items-center">
                <div class="lg:w-56 flex-shrink-0">
                  <div class={`w-14 h-14 ${s.color === "blue" ? "bg-blue-100" : s.color === "emerald" ? "bg-emerald-100" : s.color === "violet" ? "bg-violet-100" : "bg-amber-100"} rounded-xl flex items-center justify-center mb-4 text-3xl`}>
                    {s.icon}
                  </div>
                  <h3 class="text-xl font-bold text-slate-900">{s.name}</h3>
                  <p class={`text-sm font-medium mt-1 ${s.color === "blue" ? "text-blue-600" : s.color === "emerald" ? "text-emerald-600" : s.color === "violet" ? "text-violet-600" : "text-amber-600"}`}>
                    {s.tagline}
                  </p>
                </div>
                <div class="flex-1">
                  <p class="text-slate-600 leading-relaxed text-sm">{s.summary}</p>
                  <ul class="flex flex-wrap gap-2 mt-4">
                    {s.points.map((p) => (
                      <li class={`text-xs px-3 py-1 rounded-full ${s.color === "blue" ? "bg-blue-50 text-blue-700" : s.color === "emerald" ? "bg-emerald-50 text-emerald-700" : s.color === "violet" ? "bg-violet-50 text-violet-700" : "bg-amber-50 text-amber-700"}`}>
                        {p}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="flex-shrink-0">
                  <a
                    href={s.url.replace(siteURL, "")}
                    class={`inline-flex items-center px-5 py-2.5 rounded-xl text-white font-semibold text-sm transition-colors no-underline ${
                      s.color === "blue" ? "bg-blue-600 hover:bg-blue-700" : s.color === "emerald" ? "bg-emerald-600 hover:bg-emerald-700" : s.color === "violet" ? "bg-violet-600 hover:bg-violet-700" : "bg-amber-600 hover:bg-amber-700"
                    }`}
                  >
                    查看详情 →
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 如何选择 -->
  <section class="py-20 md:py-28 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-blue-600 font-semibold text-sm uppercase tracking-wider">如何选择</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">对号入座，找你的场景</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          scenarios.map((sc) => (
            <div class="bg-white rounded-2xl p-8 border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all duration-300">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="text-3xl mb-4">{sc.icon}</div>
                  <h3 class="text-xl font-bold text-slate-900 mb-2">{sc.title}</h3>
                  <p class="text-slate-600 leading-relaxed text-sm mb-6">{sc.desc}</p>
                </div>
              </div>
              <a href={sc.url} class="text-blue-600 hover:text-blue-800 font-semibold text-sm no-underline inline-flex items-center gap-1 group">
                {sc.cta} <span class="group-hover:translate-x-0.5 transition-transform">→</span>
              </a>
            </div>
          ))
        }
      </div>

      <!-- 免费工具提示 -->
      <div class="mt-10 bg-gradient-to-r from-blue-50 to-emerald-50 rounded-2xl p-6 border border-blue-100 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <p class="font-semibold text-slate-800">🛠️ 还不想约人？先用免费工具</p>
          <p class="text-slate-500 text-sm mt-1">30 秒检测你的网站是否具备 AI 搜索可见度基础：爬虫放行、结构化数据、内容可读性。</p>
        </div>
        <a href="/tool/" class="flex-shrink-0 inline-flex items-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-sm transition-colors no-underline">
          免费诊断 →
        </a>
      </div>
    </div>
  </section>

  <!-- 咨询流程 -->
  <section class="py-20 md:py-28 bg-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center mb-12">咨询流程</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center relative">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-blue-600/20">1</div>
          <h4 class="font-bold text-slate-900 mb-2">初步沟通</h4>
          <p class="text-slate-600 text-sm leading-relaxed">15 分钟免费通话，了解你的业务目标和当前搜索表现</p>
        </div>
        <div class="text-center relative">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-blue-600/20">2</div>
          <h4 class="font-bold text-slate-900 mb-2">深度诊断</h4>
          <p class="text-slate-600 text-sm leading-relaxed">基于数据全面审计技术、内容与 AI 可见度现状</p>
        </div>
        <div class="text-center relative">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-blue-600/20">3</div>
          <h4 class="font-bold text-slate-900 mb-2">方案定制</h4>
          <p class="text-slate-600 text-sm leading-relaxed">交付专属优化策略、执行路线图与优先级排序</p>
        </div>
        <div class="text-center relative">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-blue-600/20">4</div>
          <h4 class="font-bold text-slate-900 mb-2">执行陪跑</h4>
          <p class="text-slate-600 text-sm leading-relaxed">协助落地执行，定期复盘数据并持续迭代优化</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 text-center mb-12">常见问题</h2>
      <div class="space-y-4">
        <details class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-200 transition-colors">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
            我不确定该选哪个服务，怎么办？
            <span class="text-blue-500 text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            完全正常！大多数客户在开始时都不确定。建议你直接<a href="/contact" class="text-blue-600 font-medium">预约免费 15 分钟咨询</a>，
            我会了解你的情况后给出最合适的服务建议——没有任何推销压力。
          </p>
        </details>
        <details class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-200 transition-colors">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
            服务费用是多少？
            <span class="text-blue-500 text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            每个项目根据网站规模、需求深度和交付范围定价。初步沟通后我会提供明确的报价方案。
            所有项目报价透明，无隐藏费用。
          </p>
        </details>
        <details class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-200 transition-colors">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
            多久能看到效果？
            <span class="text-blue-500 text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            SEO/GEO 是中长期策略，通常需要 2-6 个月才能看到显著效果。但诊断类服务可以立即交付——你在收到报告当天就能获得明确的优化方向。
            执行类服务通常在第 2-3 个月开始显现数据变化。
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-emerald-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-20 w-64 h-64 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-20 w-64 h-64 bg-white rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        不确定哪个服务适合你？
      </h2>
      <p class="text-lg text-white/80 mb-8">
        预约免费 15 分钟咨询，我会了解你的需求并给出专业建议——零压力，纯价值。
      </p>
      <a
        href="/contact"
        class="inline-flex items-center px-8 py-4 bg-white text-blue-600 font-bold rounded-xl hover:bg-slate-100 transition-all duration-200 no-underline text-lg shadow-lg"
      >
        📅 预约免费 15 分钟咨询
      </a>
    </div>
  </section>

  <!-- JSON-LD -->
  <JsonLDSchema data={itemListSchema} />
  <JsonLDSchema data={faqSchema} />
  <JsonLDSchema data={breadcrumbSchema} />

  <!-- 旧锚点兼容：/services#seo-audit 等旧链接跳转到独立服务页 -->
  <script is:inline>
    (function () {
      var LEGACY_MAP = {
        "seo-audit": "/services/seo-audit/",
        "geo-optimization": "/services/geo-optimization/",
        "training": "/services/training/",
      };
      var hash = window.location.hash.replace("#", "");
      if (LEGACY_MAP[hash]) {
        window.location.replace(LEGACY_MAP[hash]);
      }
    })();
  </script>
</Layout>
