---
import Layout from "@layouts/Layout.astro";
import JsonLDSchema from "@components/JsonLDSchema.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import {
  SITE_URL,
  organizationRef,
  breadcrumbSchema as buildBreadcrumb,
} from "../lib/schema-entities";

// WebApplication 结构化数据（provider 统一引用 #organization）
const webAppSchema = {
  "@context": "https://schema.org",
  "@id": `${SITE_URL}/tool#web-application`,
  "@type": "WebApplication",
  name: "GEO 站点健康度诊断工具",
  url: `${SITE_URL}/tool`,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  description:
    "免费在线诊断工具：检测 GPTBot / PerplexityBot / ClaudeBot / Bytespider 等 AI 爬虫访问策略、JSON-LD 结构化数据与 HTML 正文可读性，输出 0-100 分 GEO 健康度报告。",
  provider: organizationRef,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
};

// 面包屑：可见 UI 与 BreadcrumbList JSON-LD 共用同一数据源
const breadcrumbItems = [
  { name: "首页", url: SITE_URL },
  { name: "工具", url: `${SITE_URL}/tool` },
];
const breadcrumbSchema = buildBreadcrumb(breadcrumbItems);

// FAQ 结构化数据
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "这个工具是怎么检测的？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "工具会模拟 AI 爬虫的视角，抓取目标站点的 robots.txt 与首页 HTML，检查 GPTBot、PerplexityBot、ClaudeBot、Bytespider 的放行策略、JSON-LD 结构化数据（Organization / FAQPage / Article）以及正文纯文本量，并综合计算 0-100 分健康度得分。",
      },
    },
    {
      "@type": "Question",
      name: "得分多少算健康？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "85 分以上为优秀，70 分以上为良好，50 分以上为中等；低于 50 分说明存在明显的 GEO 基础问题（如 AI 爬虫被拦截、缺少结构化数据或正文过少），建议优先修复。",
      },
    },
    {
      "@type": "Question",
      name: "免费工具与人工深度诊断有什么区别？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "免费工具检测 3 类基础信号（爬虫策略、结构化数据、内容可读性）。人工深度诊断还覆盖 AI 引擎引用现状评估、竞品对标、知识图谱建设与 3 个月执行路线图，适合希望系统提升 AI 搜索可见度的团队。了解 GEO 审计与人工诊断服务。",
      },
    },
  ],
};
---

<Layout
  title="GEO 站点健康度诊断工具 | GEO 咨询"
  description="免费 GEO 站点健康度诊断工具：检测 GPTBot、PerplexityBot、ClaudeBot、Bytespider 爬虫访问策略、JSON-LD 结构化数据与正文可读性，输出 0-100 分健康度报告。"
>
  <!-- Page Header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-20 md:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-10 w-96 h-96 bg-blue-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-blue-600/30 text-blue-200 rounded-full text-sm font-medium mb-4 border border-blue-500/30 backdrop-blur-sm">
        🛠️ 免费工具
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-white">GEO 站点健康度诊断</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        输入你的网站 URL，30 秒内获取 AI 搜索可见度体检报告——检测 AI 爬虫访问策略、结构化数据与内容可读性。
      </p>
    </div>
  </section>

  <!-- 诊断工具 -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 可见面包屑（置于正文内容区顶部，不占用 Hero 首屏） -->
      <Breadcrumb items={breadcrumbItems} />
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xl shadow-slate-900/5 p-6 md:p-10">
        <!-- URL 输入 -->
        <form id="scan-form" class="space-y-3">
          <label for="url-input" class="block text-sm font-medium text-slate-700">
            网站 URL <span class="text-red-400">*</span>
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="text"
              id="url-input"
              name="target_url"
              inputmode="url"
              autocomplete="off"
              placeholder="https://example.com"
              class="flex-1 px-4 py-3.5 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-900 placeholder:text-slate-400 disabled:bg-slate-50 disabled:text-slate-400"
            />
            <button
              type="submit"
              id="scan-btn"
              class="px-8 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all duration-200 cursor-pointer text-lg shadow-lg shadow-blue-600/20 hover:shadow-blue-600/30 disabled:opacity-60 disabled:cursor-not-allowed whitespace-nowrap"
            >
              🔍 开始诊断
            </button>
          </div>
          <p class="text-sm text-slate-400">
            免费使用，无需注册。试试：
            <button type="button" class="text-blue-600 hover:text-blue-700 font-medium" data-example="https://www.geova.cn/">geova.cn</button>
            ·
            <button type="button" class="text-blue-600 hover:text-blue-700 font-medium" data-example="https://example.com">example.com</button>
          </p>
        </form>

        <!-- 加载中 -->
        <div id="scan-loading" class="hidden mt-8 flex items-center justify-center gap-3 rounded-xl bg-blue-50 border border-blue-100 px-6 py-5" role="status">
          <span class="w-5 h-5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></span>
          <span class="text-blue-700 font-medium">正在检测 robots.txt、结构化数据与正文内容…</span>
        </div>

        <!-- 错误提示 -->
        <div id="scan-error" class="hidden mt-8 rounded-xl bg-red-50 border border-red-200 px-6 py-4 text-red-700 font-medium" role="alert"></div>

        <!-- 诊断结果 -->
        <div id="results" class="hidden mt-10">
          <!-- 得分仪表盘 + 维度得分 -->
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center gap-8">
            <!-- 仪表盘 -->
            <div class="relative flex-shrink-0">
              <svg id="gauge-svg" viewBox="0 0 180 180" class="w-44 h-44 transition-colors duration-700" role="img" aria-label="GEO 健康度得分仪表盘">
                <circle cx="90" cy="90" r="78" fill="none" stroke="#e2e8f0" stroke-width="14"></circle>
                <circle
                  id="gauge-arc"
                  cx="90"
                  cy="90"
                  r="78"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="14"
                  stroke-linecap="round"
                  stroke-dasharray="490.09"
                  stroke-dashoffset="490.09"
                  transform="rotate(-90 90 90)"
                ></circle>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <div class="flex items-baseline gap-1">
                  <span id="gauge-score" class="text-5xl font-extrabold text-slate-900">--</span>
                  <span class="text-slate-400 font-medium">/100</span>
                </div>
                <span id="gauge-grade" class="mt-1.5 px-3 py-0.5 rounded-full text-sm font-semibold bg-slate-100 text-slate-500">等待检测</span>
              </div>
            </div>

            <!-- 结果摘要 + 维度 -->
            <div class="flex-1 w-full min-w-0">
              <p id="result-summary" class="text-lg font-semibold text-slate-800 leading-relaxed"></p>
              <p class="mt-3 text-sm text-slate-500 break-all">
                <span class="font-medium text-slate-600">检测站点：</span><span id="result-url"></span>
              </p>
              <p class="mt-1 text-sm text-slate-500">
                <span class="font-medium text-slate-600">检测时间：</span><span id="result-meta"></span>
              </p>
              <div id="dimensions" class="mt-6 space-y-4"></div>
            </div>
          </div>

          <!-- 诊断明细 Checklist -->
          <div class="mt-10">
            <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
              <span>📋</span> 诊断明细
            </h2>
            <div id="checklist" class="bg-white border border-slate-200 rounded-2xl divide-y divide-slate-100 overflow-hidden"></div>
          </div>

          <!-- Crawler Access Test（HTTP UA Probe） -->
          <div id="crawler-access-section" class="mt-10 hidden">
            <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span>🛰️</span> Crawler Access Test
            </h2>
            <p class="text-sm text-slate-500 mb-4 leading-relaxed">
              robots.txt 只是「声明」，服务器 / CDN 边缘仍可能拦截。下表对 8 个 AI 爬虫各发起一次 HTTP UA 探测，并置对比声明与实际响应。
            </p>
            <div id="crawler-access" class="bg-white border border-slate-200 rounded-2xl overflow-hidden"></div>
          </div>

          <!-- 优化建议 -->
          <div class="mt-10">
            <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center gap-2">
              <span>💡</span> 优化建议
            </h2>
            <div id="recommendations" class="bg-gradient-to-br from-emerald-50 to-blue-50/50 border border-emerald-200 rounded-2xl p-6 md:p-8 space-y-4"></div>
          </div>

          <p class="mt-8 text-sm text-slate-500 text-center leading-relaxed">
            本工具检测 3 类 GEO 基础信号（爬虫策略 / 结构化数据 / 内容可读性）。
            <a href="/services/geo-audit/" data-cta-name="human_audit" class="text-blue-600 hover:text-blue-700 font-medium">人工深度诊断</a>
            还覆盖 AI 引用评估、竞品对标与知识图谱建设。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 检测维度说明 -->
  <section class="py-16 bg-slate-50 border-y border-slate-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 text-center mb-10">检测维度与评分权重</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-6 text-3xl">🤖</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">AI 爬虫访问<span class="ml-2 text-sm font-semibold text-blue-600">40 分</span></h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            检查 robots.txt 是否放行 GPTBot、PerplexityBot、ClaudeBot、Bytespider。被拦截 = AI 引擎无法抓取你的内容，品牌将完全消失在 AI 答案中。
          </p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center mb-6 text-3xl">🧩</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">结构化数据<span class="ml-2 text-sm font-semibold text-emerald-600">30 分</span></h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            检测 Organization、FAQPage、Article 等 JSON-LD 标记。结构化数据帮助 AI 准确理解实体关系、问答内容与文章语义。
          </p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-6 text-3xl">📄</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">内容可读性<span class="ml-2 text-sm font-semibold text-amber-600">30 分</span></h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            统计 HTML 直出的正文纯文本量，预警 CSR 动态渲染。AI 爬虫通常不执行 JavaScript——它看不到的内容，等于不存在。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 常见问题 -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 text-center mb-10">常见问题</h2>
      <div class="space-y-4">
        <details class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-200 transition-colors">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
            这个工具是怎么检测的？
            <span class="text-blue-500 text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            工具会模拟 AI 爬虫的视角，抓取目标站点的 robots.txt 与首页 HTML，检查 GPTBot、PerplexityBot、ClaudeBot、Bytespider
            的放行策略、JSON-LD 结构化数据（Organization / FAQPage / Article）以及正文纯文本量，并综合计算 0-100 分健康度得分。
          </p>
        </details>
        <details class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-200 transition-colors">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
            得分多少算健康？
            <span class="text-blue-500 text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            85 分以上为优秀，70 分以上为良好，50 分以上为中等；低于 50 分说明存在明显的 GEO 基础问题（如 AI 爬虫被拦截、缺少结构化数据或正文过少），建议优先修复。
          </p>
        </details>
        <details class="group bg-white rounded-xl border border-slate-200 p-6 hover:border-blue-200 transition-colors">
          <summary class="font-semibold text-slate-900 cursor-pointer list-none flex items-center justify-between">
            免费工具与人工深度诊断有什么区别？
            <span class="text-blue-500 text-lg group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-slate-600 mt-4 leading-relaxed">
            免费工具检测 3 类基础信号（爬虫策略、结构化数据、内容可读性）。人工深度诊断还覆盖 AI 引擎引用现状评估、竞品对标、知识图谱建设与
            3 个月执行路线图，适合希望系统提升 AI 搜索可见度的团队。了解
            <a href="/services/geo-audit/" class="text-blue-600 font-medium">GEO 审计与人工诊断服务</a>。
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 预约 CTA -->
  <section class="py-20 bg-gradient-to-r from-blue-600 to-emerald-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-20 w-64 h-64 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-20 w-64 h-64 bg-white rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        报告发现问题，不知道如何修复？
      </h2>
      <p class="text-lg text-white/80 mb-8">
        免费工具只覆盖基础信号——AI 引用评估、竞品对标与执行路线图，需要人工深度诊断。
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/services/geo-audit/"
          data-cta-name="human_audit"
          class="inline-flex items-center px-8 py-4 bg-white text-blue-600 font-bold rounded-xl hover:bg-slate-100 transition-all duration-200 no-underline text-lg shadow-lg"
        >
          🩺 了解 GEO 人工深度诊断
        </a>
        <a
          href="/contact"
          data-cta-name="book_consultation"
          class="inline-flex items-center px-8 py-4 bg-white/10 text-white font-semibold rounded-xl border border-white/20 hover:bg-white/20 transition-all duration-200 no-underline backdrop-blur-sm"
        >
          📅 或先预约免费咨询
        </a>
      </div>
    </div>
  </section>

  <!-- JSON-LD 结构化数据 -->
  <JsonLDSchema data={webAppSchema} />
  <JsonLDSchema data={faqSchema} />
  <JsonLDSchema data={breadcrumbSchema} />
</Layout>

<script>
  import { track, safePageUrl } from "../lib/analytics";

  const form = document.getElementById("scan-form");
  const input = document.getElementById("url-input");
  const scanBtn = document.getElementById("scan-btn");
  const loadingBox = document.getElementById("scan-loading");
  const errorBox = document.getElementById("scan-error");
  const resultsBox = document.getElementById("results");

  const gaugeSvg = document.getElementById("gauge-svg");
  const gaugeArc = document.getElementById("gauge-arc");
  const gaugeScore = document.getElementById("gauge-score");
  const gaugeGrade = document.getElementById("gauge-grade");

  const dimensionsBox = document.getElementById("dimensions");
  const checklistBox = document.getElementById("checklist");
  const recommendationsBox = document.getElementById("recommendations");
  const crawlerAccessSection = document.getElementById("crawler-access-section");
  const crawlerAccessBox = document.getElementById("crawler-access");

  const resultSummary = document.getElementById("result-summary");
  const resultUrl = document.getElementById("result-url");
  const resultMeta = document.getElementById("result-meta");

  // 最近一次成功报告得分：结果区 CTA（tool_cta_click）需要时附带 score
  let lastScore = null;

  // 2 * PI * 78（仪表盘半径）
  const GAUGE_CIRCUMFERENCE = 490.09;

  const SCORE_TEXT_CLASSES = ["text-emerald-500", "text-blue-500", "text-amber-500", "text-red-500"];

  const GRADE_BADGE_CLASSES = {
    excellent: "bg-emerald-100 text-emerald-700",
    good: "bg-blue-100 text-blue-700",
    medium: "bg-amber-100 text-amber-700",
    weak: "bg-red-100 text-red-700",
  };

  const DIMENSION_BAR_CLASSES = {
    pass: "bg-emerald-500",
    warning: "bg-amber-500",
    fail: "bg-red-500",
    error: "bg-red-400",
    info: "bg-blue-500",
  };

  const CHECKLIST_ICONS = {
    pass: { cls: "bg-emerald-100 text-emerald-600", icon: "✓" },
    warning: { cls: "bg-amber-100 text-amber-600", icon: "!" },
    fail: { cls: "bg-red-100 text-red-600", icon: "✗" },
    error: { cls: "bg-slate-200 text-slate-500", icon: "?" },
    info: { cls: "bg-blue-100 text-blue-600", icon: "i" },
  };

  const DIMENSION_ORDER = [
    { key: "crawlers", label: "AI 爬虫访问", icon: "🤖" },
    { key: "structuredData", label: "结构化数据", icon: "🧩" },
    { key: "content", label: "内容可读性", icon: "📄" },
  ];

  // Crawler Access Test（HTTP UA Probe）：声明层 robots.txt × 执行层 HTTP 响应
  const ROBOTS_BADGES = {
    Allow: "bg-emerald-100 text-emerald-700",
    Disallow: "bg-red-100 text-red-700",
    Unknown: "bg-slate-100 text-slate-500",
    Error: "bg-slate-200 text-slate-500",
  };

  const HTTP_RESULT_BADGES = {
    Success: "bg-emerald-100 text-emerald-700",
    Blocked: "bg-red-100 text-red-700",
    RateLimited: "bg-amber-100 text-amber-700",
    NotFound: "bg-amber-100 text-amber-700",
    ServerError: "bg-amber-100 text-amber-700",
    RedirectUnresolved: "bg-amber-100 text-amber-700",
    Timeout: "bg-amber-100 text-amber-700",
    Error: "bg-slate-200 text-slate-600",
    Skipped: "bg-slate-100 text-slate-500",
  };

  function esc(value) {
    return String(value).replace(
      /[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]
    );
  }

  // P0-1 漏斗修复：服务端固定建议文案「可预约人工诊断服务」原本经 esc() 后为纯文本、
  // 无导航目标；此处先转义再将该短语包裹为真实 <a href>（文案与诊断内容不变，
  // 不依赖 JavaScript 完成导航）。
  function renderRecommendation(rec) {
    const safe = esc(rec);
    const phrase = "可预约人工诊断服务";
    if (!safe.includes(phrase)) return safe;
    return safe.replace(
      phrase,
      `<a href="/services/geo-audit/" data-cta-name="human_audit" class="text-blue-600 hover:text-blue-700 font-medium no-underline hover:underline">${phrase}</a>`
    );
  }

  function scoreTextClass(score) {
    if (score >= 85) return "text-emerald-500";
    if (score >= 70) return "text-blue-500";
    if (score >= 50) return "text-amber-500";
    return "text-red-500";
  }

  function gradeBadgeClass(score) {
    if (score >= 85) return GRADE_BADGE_CLASSES.excellent;
    if (score >= 70) return GRADE_BADGE_CLASSES.good;
    if (score >= 50) return GRADE_BADGE_CLASSES.medium;
    return GRADE_BADGE_CLASSES.weak;
  }

  function setLoading(on) {
    loadingBox.classList.toggle("hidden", !on);
    scanBtn.disabled = on;
    scanBtn.innerHTML = on ? "⏳ 诊断中…" : "🔍 开始诊断";
    input.disabled = on;
  }

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function hideError() {
    errorBox.classList.add("hidden");
  }

  // 示例 URL 快捷填充
  document.querySelectorAll("[data-example]").forEach((btn) => {
    btn.addEventListener("click", () => {
      input.value = btn.dataset.example || "";
      input.focus();
    });
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    hideError();

    const value = input.value.trim();
    if (!value) {
      showError("请输入要诊断的网站 URL");
      input.focus();
      return;
    }

    resultsBox.classList.add("hidden");
    // 埋点：用户真正开始执行扫描（校验通过，即将请求 /api/scan）。
    // 空输入校验失败不产生事件（尚未开始扫描）。source_url 已清洗为 origin+path。
    const scanSource = safePageUrl(value);
    track("tool_scan_start", scanSource ? { source_url: scanSource } : {});
    setLoading(true);
    try {
      const res = await fetch("/api/scan", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ target_url: value }),
      });
      let data = null;
      try {
        data = await res.json();
      } catch {
        // 非 JSON 响应，按失败处理
      }
      if (!res.ok || !data || !data.success) {
        // 埋点：API 明确返回错误 / 非成功响应。只上报粗粒度 error_type，不上报报错原文，
        // 避免错误信息里回显的目标站点细节或用户输入进入 GA4。
        track("tool_scan_error", { error_type: "api_error" });
        showError((data && data.error) || `诊断失败（HTTP ${res.status}），请稍后重试`);
        return;
      }
      renderResults(data);
      // 埋点：扫描成功返回即同步渲染报告，二者是同一用户动作、无中间步骤，
      // 故 tool_scan_complete 与 tool_report_view 合并为一次上报（见验收报告说明）。
      const reportUrl = safePageUrl(data.url || value);
      track("tool_scan_complete", { score: data.score, ...(reportUrl ? { source_url: reportUrl } : {}) });
    } catch {
      track("tool_scan_error", { error_type: "network_error" });
      showError("网络异常，无法完成诊断，请稍后重试");
    } finally {
      setLoading(false);
    }
  });

  // tool_cta_click：结果区 / 页尾 CTA 点击（带 data-cta-name 的链接）。
  // 埋点不阻断导航：同步 push、不 preventDefault；GTM/GA4 加载失败也不影响跳转。
  document.addEventListener("click", (event) => {
    const anchor = event.target instanceof Element ? event.target.closest("a[data-cta-name]") : null;
    if (!anchor) return;
    const payload = {
      cta_name: anchor.getAttribute("data-cta-name") || "",
      cta_target: anchor.getAttribute("href") || "",
    };
    if (lastScore !== null) payload.score = lastScore;
    track("tool_cta_click", payload);
  });

  function crawlerAccessBadge(text, cls, title) {
    return `<span class="text-[11px] font-semibold px-2 py-0.5 rounded-full ${cls}"${
      title ? ` title="${esc(title)}"` : ""
    }>${esc(text)}</span>`;
  }

  // Crawler Access Test 渲染：每个爬虫并置展示 robots.txt 声明与 HTTP UA 探测结果。
  // 无数据（旧接口 / 探测整体失败）时隐藏整个区块，不影响原有结果展示。
  function renderCrawlerAccess(report) {
    const results = report && Array.isArray(report.results) ? report.results : [];
    if (!results.length) {
      crawlerAccessSection.classList.add("hidden");
      return;
    }

    const summary = report.summary || {};
    const mismatch = summary.mismatch || 0;
    const headCls =
      mismatch > 0
        ? "bg-amber-50 border-amber-200 text-amber-900"
        : "bg-emerald-50 border-emerald-200 text-emerald-900";

    const rows = results
      .map((item) => {
        const robotsCls = ROBOTS_BADGES[item.robots] || ROBOTS_BADGES.Unknown;
        const httpCls = HTTP_RESULT_BADGES[item.httpResult] || HTTP_RESULT_BADGES.Error;
        const httpText = item.httpStatus ? `${item.httpStatus} ${item.httpResult}` : String(item.httpResult);

        const meta = [];
        if (typeof item.httpResponseTimeMs === "number") meta.push(`耗时 ${item.httpResponseTimeMs} ms`);
        if (item.redirects) meta.push(`跳转 ${item.redirects} 次`);
        if (item.finalUrl) meta.push(`最终 URL：${item.finalUrl}`);

        return `
        <div class="px-6 py-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-semibold text-slate-800 text-sm">${esc(item.name)}</span>
            <span class="text-[11px] px-2 py-0.5 bg-slate-100 text-slate-500 rounded-full">${esc(item.group || "")}</span>
            ${
              item.mismatch
                ? '<span class="text-[11px] px-2 py-0.5 bg-amber-100 text-amber-700 rounded-full">声明与执行不一致</span>'
                : ""
            }
          </div>
          <p class="mt-1 text-sm ${item.mismatch ? "text-amber-700 font-medium" : "text-slate-500"} break-words">${esc(item.message || "")}</p>
          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-slate-500">
            <span class="inline-flex items-center gap-1.5">robots.txt: ${crawlerAccessBadge(item.robots, robotsCls, item.robotsRule)}</span>
            <span class="inline-flex items-center gap-1.5">HTTP Access: ${crawlerAccessBadge(httpText, httpCls)}</span>
          </div>
          ${meta.length ? `<p class="mt-1.5 text-xs text-slate-400 break-all">${esc(meta.join(" · "))}</p>` : ""}
        </div>`;
      })
      .join("");

    crawlerAccessBox.innerHTML = `
      <div class="px-6 py-4 border-b border-slate-100 ${headCls}">
        <p class="text-sm font-semibold">${esc(report.note || "")}</p>
        <p class="mt-1 text-xs opacity-80">
          robots.txt：放行 ${summary.robotsAllow || 0} · 禁止 ${summary.robotsDisallow || 0} · 未声明/失败 ${summary.robotsUnknown || 0}
          ｜ HTTP 探测：成功 ${summary.httpSuccess || 0} · 被拒绝 ${summary.httpBlocked || 0} · 未探测 ${summary.httpSkipped || 0} · 其它 ${summary.httpOther || 0}
        </p>
      </div>
      <div class="divide-y divide-slate-100">${rows}</div>
      ${
        report.disclaimer
          ? `<div class="px-6 py-4 bg-slate-50 border-t border-slate-100"><p class="text-xs text-slate-500 leading-relaxed">${esc(report.disclaimer)}</p></div>`
          : ""
      }`;
    crawlerAccessSection.classList.remove("hidden");
  }

  function renderResults(data) {
    // 记录当前展示报告的得分，供结果区 CTA 埋点附 score
    lastScore = typeof data.score === "number" ? data.score : null;
    // 摘要信息
    resultSummary.textContent = data.summary || "";
    resultUrl.textContent = data.url || "";
    resultMeta.textContent = `${data.scannedAt || ""} · 用时 ${((data.durationMs || 0) / 1000).toFixed(1)} 秒`;

    // 仪表盘
    gaugeSvg.classList.remove(...SCORE_TEXT_CLASSES);
    gaugeSvg.classList.add(scoreTextClass(data.score));
    gaugeScore.textContent = String(data.score);
    gaugeGrade.textContent = data.grade || "";
    gaugeGrade.className = `mt-1.5 px-3 py-0.5 rounded-full text-sm font-semibold ${gradeBadgeClass(data.score)}`;

    // 得分动画：从 0 过渡到目标值
    gaugeArc.style.transition = "none";
    gaugeArc.style.strokeDashoffset = String(GAUGE_CIRCUMFERENCE);
    void gaugeArc.getBoundingClientRect();
    gaugeArc.style.transition = "stroke-dashoffset 1.2s cubic-bezier(0.22, 1, 0.36, 1)";
    requestAnimationFrame(() => {
      gaugeArc.style.strokeDashoffset = String(GAUGE_CIRCUMFERENCE * (1 - data.score / 100));
    });

    // 维度得分条
    const dims = data.dimensions || {};
    dimensionsBox.innerHTML = DIMENSION_ORDER.map((d) => {
      const dim = dims[d.key];
      if (!dim) return "";
      const pct = Math.round((dim.score / dim.maxScore) * 100);
      const barCls = DIMENSION_BAR_CLASSES[dim.status] || "bg-slate-300";
      return `
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-semibold text-slate-700">${d.icon} ${d.label}</span>
            <span class="text-sm font-bold text-slate-900">${dim.score}<span class="text-slate-400 font-medium"> / ${dim.maxScore}</span></span>
          </div>
          <div class="h-2.5 bg-slate-200 rounded-full overflow-hidden">
            <div class="h-full ${barCls} rounded-full transition-all duration-1000" style="width: 0%" data-width="${pct}"></div>
          </div>
          <p class="mt-1 text-xs text-slate-500">${esc(dim.note || "")}</p>
        </div>`;
    }).join("");
    requestAnimationFrame(() => {
      dimensionsBox.querySelectorAll("[data-width]").forEach((bar) => {
        bar.style.width = `${bar.dataset.width}%`;
      });
    });

    // 诊断明细 Checklist
    checklistBox.innerHTML = (data.checklist || []).map((item) => {
      const icon = CHECKLIST_ICONS[item.status] || CHECKLIST_ICONS.info;
      return `
        <div class="flex items-start gap-3 px-6 py-4">
          <span class="w-6 h-6 ${icon.cls} rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">${icon.icon}</span>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-semibold text-slate-800 text-sm">${esc(item.label)}</span>
              <span class="text-[11px] px-2 py-0.5 bg-slate-100 text-slate-500 rounded-full">${esc(item.category)}</span>
            </div>
            <p class="mt-0.5 text-sm text-slate-500 break-all">${esc(item.detail)}</p>
          </div>
        </div>`;
    }).join("");

    // Crawler Access Test（声明层 × 执行层）
    renderCrawlerAccess(data.crawlerAccess);

    // 优化建议
    recommendationsBox.innerHTML = (data.recommendations || []).map(
      (rec) => `
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">▶</span>
          <p class="text-slate-700 leading-relaxed text-sm md:text-base">${renderRecommendation(rec)}</p>
        </div>`
    ).join("");

    resultsBox.classList.remove("hidden");
    resultsBox.scrollIntoView({ behavior: "smooth", block: "start" });
  }
</script>
