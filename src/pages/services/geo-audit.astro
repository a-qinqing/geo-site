---
import Layout from "@layouts/Layout.astro";
import JsonLDSchema from "@components/JsonLDSchema.astro";

const siteURL = Astro.site?.origin || "https://www.geova.cn/";
const pageURL = `${siteURL}/services/geo-audit/`;

// Service 结构化数据
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GEO 审计与 AI 搜索诊断服务",
  url: pageURL,
  serviceType: "GEO 审计 / GEO 网站诊断 / AI 搜索可见度诊断",
  description:
    "人工 GEO 深度诊断：在 ChatGPT、Perplexity、Gemini 等 AI 引擎中实测品牌被提及、被引用、被推荐的真实情况，叠加竞品对标、实体与内容审查，交付可见度基线报告与 3 个月执行路线图。",
  provider: {
    "@type": "Organization",
    name: "GEO 咨询",
    url: siteURL,
  },
  areaServed: {
    "@type": "Continent",
    name: "全球（线上服务）",
  },
  availableChannel: {
    "@type": "ServiceChannel",
    serviceUrl: `${siteURL}/contact`,
    availableLanguage: ["zh-CN", "en"],
  },
};

// BreadcrumbList 结构化数据
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: siteURL },
    { "@type": "ListItem", position: 2, name: "服务", item: `${siteURL}/services/` },
    { "@type": "ListItem", position: 3, name: "GEO 审计与 AI 搜索诊断", item: pageURL },
  ],
};
---

<Layout
  title="GEO 审计与 AI 搜索诊断服务 | GEO 咨询"
  description="GEO 审计（人工深度诊断）：实测品牌在 ChatGPT、Perplexity、Gemini 等 AI 引擎中被提及、被引用、被推荐的真实情况，叠加竞品对标与实体审查，交付 AI 搜索可见度基线报告与执行路线图。"
>
  <!-- Page Header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-20 md:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-10 w-96 h-96 bg-violet-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-violet-600/30 text-violet-200 rounded-full text-sm font-medium mb-4 border border-violet-500/30 backdrop-blur-sm">
        🩺 GEO 人工深度诊断
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-white">GEO 审计与 AI 搜索诊断</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        当客户问 AI"哪个品牌值得考虑"时，AI 会怎么回答？
        人工审计帮你<strong class="text-violet-300">看清品牌在 AI 搜索中的真实可见度</strong>——被提及、被引用、被推荐，逐项测出来。
      </p>
    </div>
  </section>

  <!-- 免费工具 vs 人工审计 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-violet-600 font-semibold text-sm uppercase tracking-wider">为什么需要人工审计</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">免费工具之外，还差一步</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          <a href="/tool/" class="text-violet-600 font-medium no-underline hover:underline">免费诊断工具</a>
          检查的是"地基"：AI 爬虫能否访问、结构化数据是否存在、内容是否可读。
          但地基之上——AI 引擎<strong>实际上怎么评价你的品牌</strong>——需要人工实测才能看清。
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- 免费工具 -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">🛠️</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900">免费工具检测</h3>
              <p class="text-sm text-slate-500">适合：快速体检、日常自查</p>
            </div>
          </div>
          <ul class="space-y-3 list-none pl-0 my-0">
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-slate-200 text-slate-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">A</span>
              AI 爬虫访问策略（robots.txt 放行情况）
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-slate-200 text-slate-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">B</span>
              结构化数据检测（JSON-LD 类型覆盖）
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-slate-200 text-slate-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">C</span>
              正文可读性检测（HTML 直出内容量）
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-slate-200 text-slate-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">D</span>
              0-100 分综合健康度评分（自动化）
            </li>
          </ul>
          <p class="text-xs text-slate-400 mt-5 border-t border-slate-200 pt-4">
            30 秒出结果，免费无限次——先来
            <a href="/tool/" class="text-violet-600 font-medium no-underline hover:underline">测一下</a>准没错。
          </p>
        </div>

        <!-- 人工审计 -->
        <div class="rounded-2xl border border-violet-200 bg-gradient-to-br from-violet-50 to-violet-100/40 p-8 relative overflow-hidden">
          <span class="absolute top-4 right-4 text-xs font-bold bg-violet-600 text-white px-3 py-1 rounded-full">人工深度诊断</span>
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">🩺</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900">GEO 审计</h3>
              <p class="text-sm text-slate-500">适合：准备投入 GEO、需要决策依据</p>
            </div>
          </div>
          <ul class="space-y-3 list-none pl-0 my-0">
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-violet-200 text-violet-700 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">1</span>
              AI 引擎真实可见度实测：品牌被提及 / 引用 / 推荐，逐条记录
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-violet-200 text-violet-700 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">2</span>
              竞品可见度对照：你在 AI 答案里的位置 vs 竞争对手
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-violet-200 text-violet-700 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">3</span>
              实体与知识图谱审查：AI 理解的"你是谁"对不对
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-violet-200 text-violet-700 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">4</span>
              内容与信源审查：哪些内容被引用、哪些该建没建
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="w-5 h-5 bg-violet-200 text-violet-700 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">5</span>
              交付可见度基线报告 + 3 个月执行路线图
            </li>
          </ul>
          <p class="text-xs text-slate-500 mt-5 border-t border-violet-200 pt-4">
            人工逐条分析 + 多引擎实测，产出可复测的基线——后续优化有没有效，拿它说话。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 审计内容五层 -->
  <section class="py-20 md:py-28 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-violet-600 font-semibold text-sm uppercase tracking-wider">审计内容</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">一次审计，回答五个问题</h2>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-violet-100 text-violet-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">1</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">可见度实测</h3>
                <p class="text-violet-600 text-sm font-medium">AI 到底怎么说你？</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                针对你的行业与目标客户设计固定问题集，在 ChatGPT、Perplexity、Gemini（及适用时豆包、DeepSeek 等国内引擎）
                逐题实测，记录品牌是否被提及、被引用、被推荐，以及描述倾向是正面、中性还是缺失。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">多引擎 × 固定问题集</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">提及 / 引用 / 推荐三指标</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">语义倾向记录</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-violet-100 text-violet-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">2</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">竞品对标</h3>
                <p class="text-violet-600 text-sm font-medium">对手在哪里压着你？</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                同一组问题下记录 3-5 个核心竞品的表现：谁被优先推荐、谁的官网被引用、
                竞品在 AI 答案中呈现了什么信息结构——差距即机会清单。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">竞品可见度记录</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">信息结构差异</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">差距机会清单</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-violet-100 text-violet-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">3</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">实体与知识图谱</h3>
                <p class="text-violet-600 text-sm font-medium">AI 认识的你，是完整的你吗？</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                审查品牌、人物、服务的实体一致性与结构化数据：各平台信息是否统一、
                Schema.org 是否部署到位、AI 是否把官网与你本人 / 品牌正确关联。实体断裂是"被推荐"的最大隐形障碍。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">品牌实体一致性</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">结构化数据审查</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">外部信源核对</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-violet-100 text-violet-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">4</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">内容与信源审查</h3>
                <p class="text-violet-600 text-sm font-medium">该被引用的内容，建了吗？</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                对照 AI 引用规律盘点你的内容资产：对比页、定义页、数据页、FAQ 这些高引用率页型是否存在、
                是否可被机器提取、来源是否清晰。AI 引用的是可交叉验证的事实——内容审查看的就是这个。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">高引用率页型盘点</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">事实可验证性</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">引用来源清晰度</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-violet-100 text-violet-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">5</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">路线图输出</h3>
                <p class="text-violet-600 text-sm font-medium">知道了，然后呢？</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                所有发现收敛为一份可执行的 3 个月路线图：先修什么、建什么内容、补什么信源、
                按什么顺序做、如何复测——路线图可以直接独立执行，也可以衔接我们的 GEO 优化服务持续落地。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">问题分级优先级</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">3 个月执行排期</span>
                <span class="bg-violet-50 text-violet-700 px-3 py-1 rounded-full">复测机制建议</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 流程与交付 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <h2 class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span>📦</span> 审计交付物
          </h2>
          <p class="text-slate-500 text-sm mb-6">一套完整、可复测的 AI 搜索可见度基线。</p>
          <ul class="space-y-3 list-none pl-0 my-0">
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-violet-500 mt-0.5">✓</span>
              <span>AI 引擎可见度实测报告（多引擎 × 固定问题集逐条记录）</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-violet-500 mt-0.5">✓</span>
              <span>竞品对标分析（可见度位置 + 信息结构差异）</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-violet-500 mt-0.5">✓</span>
              <span>实体与结构化数据问题清单</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-violet-500 mt-0.5">✓</span>
              <span>内容与信源建设清单（高引用率页型优先级）</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-violet-500 mt-0.5">✓</span>
              <span>3 个月执行路线图（可独立执行或衔接 GEO 优化服务）</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-violet-500 mt-0.5">✓</span>
              <span>60 分钟报告解读会议（含复测方法讲解）</span>
            </li>
          </ul>
        </div>

        <div class="space-y-6">
          <div class="bg-gradient-to-br from-violet-50 to-violet-100/40 rounded-2xl p-8 border border-violet-200">
            <h2 class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2">
              <span>🎯</span> 适合你吗？
            </h2>
            <ul class="space-y-3 list-none pl-0 my-0">
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">1</span>
                准备投入 GEO 优化，但想先拿到决策依据和基线数据
              </li>
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">2</span>
                已经做了免费检测，想知道"及格之外"的真实差距
              </li>
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">3</span>
                品牌在 AI 答案中"被提但不对""被忽略"——想搞清楚为什么
              </li>
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">4</span>
                内部汇报需要一份客观的 AI 可见度现状报告作为起点
              </li>
            </ul>
          </div>

          <div class="bg-white rounded-2xl p-8 border border-slate-200">
            <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
              <span>🔄</span> 审计流程
            </h2>
            <ol class="space-y-3 list-none pl-0 my-0">
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">1</span>
                15 分钟沟通：确认行业、目标客户与竞品清单
              </li>
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">2</span>
                多引擎实测 + 实体 / 内容 / 信源人工审查
              </li>
              <li class="flex items-start gap-3 text-slate-600 text-sm">
                <span class="w-6 h-6 bg-violet-100 text-violet-600 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">3</span>
                撰写可见度基线报告与执行路线图
              </li>
              <li class="flex items-start gap-3 text-slate-600 text-sm">
