---
import Layout from "@layouts/Layout.astro";
import JsonLDSchema from "@components/JsonLDSchema.astro";

const siteURL = Astro.site?.origin || "https://www.geova.cn/";
const pageURL = `${siteURL}/services/geo-optimization/`;

// Service 结构化数据
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GEO 优化服务（AI 搜索可见度优化）",
  url: pageURL,
  serviceType: "GEO 优化 / AI 搜索可见度优化 / AI 引用优化",
  description:
    "系统提升品牌在 ChatGPT、Perplexity、Google AI Overviews、Gemini 等 AI 引擎中的可见度、引用率与推荐率：从可见度基线评估、实体与结构化数据建设，到 AI 友好内容策略与多平台品牌信号。",
  provider: {
    "@type": "Organization",
    name: "GEO 咨询",
    url: siteURL,
  },
  areaServed: {
    "@type": "Continent",
    name: "全球（线上服务）",
  },
  availableChannel: {
    "@type": "ServiceChannel",
    serviceUrl: `${siteURL}/contact`,
    availableLanguage: ["zh-CN", "en"],
  },
};

// FAQ 结构化数据（与页面可见 FAQ 一致）
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "GEO 优化和传统 SEO 是什么关系？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "SEO 优化的是搜索结果页排名，GEO 优化的是品牌在 AI 引擎答案中的可见度、引用与推荐。两者互补：SEO 打牢技术基础与内容质量，GEO 让这些资产被 AI 引擎发现并引用。",
      },
    },
    {
      "@type": "Question",
      name: "GEO 优化多久能看到效果？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "结构化数据与可抓取性问题通常在数周内见效；引用率与推荐率的系统性变化一般需要 2-6 个月，取决于内容资产规模与行业竞争程度。项目开始前我们会先建立可见度基线，便于按季度衡量变化。",
      },
    },
    {
      "@type": "Question",
      name: "项目如何开始？需要先做人工审计吗？",
      acceptedAnswer: {
        "@type": "Answer",
        text: "可以先用免费工具初步检测，或预约 15 分钟咨询了解现状。正式项目建议先做 GEO 人工审计建立基线——看清品牌在 AI 引擎中被提及、被引用的真实情况，再进入持续优化。",
      },
    },
  ],
};

// BreadcrumbList 结构化数据
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首页", item: siteURL },
    { "@type": "ListItem", position: 2, name: "服务", item: `${siteURL}/services/` },
    { "@type": "ListItem", position: 3, name: "GEO 优化服务", item: pageURL },
  ],
};
---

<Layout
  title="GEO 优化服务 | GEO 咨询"
  description="GEO 优化服务：系统提升品牌在 ChatGPT、Perplexity、Google AI Overviews、Gemini 等 AI 引擎中的可见度与引用率。从基线评估、实体与结构化数据，到 AI 友好内容与品牌信号，让品牌在 AI 答案中被发现、被引用、被信任。"
>
  <!-- Page Header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-20 md:py-24">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 right-10 w-96 h-96 bg-emerald-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-emerald-600/30 text-emerald-200 rounded-full text-sm font-medium mb-4 border border-emerald-500/30 backdrop-blur-sm">
        🤖 GEO / AI 搜索可见度优化
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-white">GEO 优化服务</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto">
        当用户问 AI"该选谁"时，你的品牌在答案里吗？
        GEO（生成式引擎优化）的目标很直接：让品牌在 AI 答案中被<strong class="text-emerald-300">发现</strong>、被<strong class="text-emerald-300">引用</strong>、被<strong class="text-emerald-300">信任</strong>。
      </p>
    </div>
  </section>

  <!-- 为什么需要 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <span class="text-emerald-600 font-semibold text-sm uppercase tracking-wider">为什么是现在</span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-6">搜索入口正在换血</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            ChatGPT、Perplexity、Google AI Overviews、AI Mode 正在成为新一代流量入口。
            与传统搜索"给十个链接"不同，AI 引擎直接<strong>生成答案</strong>——只有少数品牌会被写进答案，
            而答案下方的链接越来越少有人点。
          </p>
          <p class="text-slate-600 leading-relaxed mb-4">
            在 AI 搜索里，传统排名思维失效：品牌<strong>被提及</strong>比"排第一"更重要，
            <strong>被引用</strong>比"获得外链"更稀缺。关键词排名的终点，
            变成了 AI 可见度的起点——这就是 GEO 要做的事。
          </p>
          <p class="text-slate-600 leading-relaxed">
            我们在<a href="/blog/what-is-geo/" class="text-emerald-600 font-medium no-underline hover:underline">博客里系统讲过 GEO 是什么</a>；
            在这里，讲清楚我们如何帮你落地。
          </p>
        </div>

        <!-- 数据侧卡 -->
        <div class="space-y-6">
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-4">GEO 优化的三个层面</h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <span class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-lg flex items-center justify-center flex-shrink-0 font-bold">1</span>
                <div>
                  <p class="font-semibold text-slate-800 text-sm">被提及（Mention）</p>
                  <p class="text-slate-500 text-sm mt-0.5">品牌进入 AI 答案的候选集合——可见度的地基</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-lg flex items-center justify-center flex-shrink-0 font-bold">2</span>
                <div>
                  <p class="font-semibold text-slate-800 text-sm">被引用（Citation）</p>
                  <p class="text-slate-500 text-sm mt-0.5">你的内容成为 AI 回答的证据来源——信任的凭证</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-8 h-8 bg-emerald-100 text-emerald-600 rounded-lg flex items-center justify-center flex-shrink-0 font-bold">3</span>
                <div>
                  <p class="font-semibold text-slate-800 text-sm">被推荐（Recommendation）</p>
                  <p class="text-slate-500 text-sm mt-0.5">商业问题里 AI 主动推荐你的品牌——增长的终点</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gradient-to-br from-emerald-50 to-emerald-100/50 rounded-2xl p-8 border border-emerald-200">
            <p class="text-sm text-slate-600 leading-relaxed">
              💡 想先知道品牌现状？用我们的
              <a href="/tool/" class="text-emerald-700 font-semibold no-underline hover:underline">免费 GEO 诊断工具</a>
              30 秒检测基础健康度；想看 AI 引擎里的真实可见度，则从
              <a href="/services/geo-audit/" class="text-emerald-700 font-semibold no-underline hover:underline">GEO 人工审计</a>
              开始。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 服务内容：四大模块 -->
  <section class="py-20 md:py-28 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-emerald-600 font-semibold text-sm uppercase tracking-wider">服务内容</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2 mb-4">四个模块，覆盖 GEO 全链路</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          不是一次性"改几个标签"，而是围绕 AI 引擎如何理解、抓取、引用品牌，建立一套可运转的系统。
        </p>
      </div>

      <div class="space-y-6">
        <!-- 模块 1 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">1</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">AI 可见度基线评估</h3>
                <p class="text-emerald-600 text-sm font-medium">先知道"现在在哪"</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                用固定问题集在 ChatGPT、Perplexity、Gemini、豆包等引擎中实测品牌被提及、被引用、
                被推荐的情况，建立可复测的可见度基线——没有基线，后续优化就无法衡量。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">品牌提及率测试</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">引用来源盘点</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">竞品对照</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 模块 2 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">2</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">实体与结构化数据</h3>
                <p class="text-emerald-600 text-sm font-medium">帮 AI 准确理解"你是谁"</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                AI 引擎靠实体识别来组织知识。品牌名不一致、关键信息缺失、结构化数据错位，
                都会让 AI 无法把"你"拼成完整实体。我们用 Schema.org 建立品牌、人物、服务、文章之间的明确关系，
                配合知识图谱思维梳理实体信号。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">Organization / Person / Service</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">品牌信息一致性审计</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">结构化数据部署与验证</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 模块 3 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">3</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">AI 友好内容与引用优化</h3>
                <p class="text-emerald-600 text-sm font-medium">让内容成为 AI 愿意引用的证据</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                AI 引用的是"可交叉验证的事实"，不是自夸的广告语。我们重构内容为 AI 可解析的知识结构：
                事实先行、来源明确、问答直接，同时系统布局可能被引用的对比页、定义页与数据页。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">问答结构内容</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">可引用对比内容</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">事实型内容改造</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 模块 4 -->
        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
          <div class="flex flex-col lg:flex-row gap-6 items-start">
            <div class="lg:w-1/4 flex items-start gap-3">
              <span class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0 text-lg font-bold">4</span>
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">品牌信号与权威建设</h3>
                <p class="text-emerald-600 text-sm font-medium">让全网都在替你说话</p>
              </div>
            </div>
            <div class="lg:w-3/4">
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                AI 的训练与检索不只依赖官网。在行业媒体、问答社区、第三方评测等权威信源建立一致的
                品牌提及矩阵，同时规划高质量引荐来源——品牌在 AI 生态里的存在感，
                由全网信号共同决定。
              </p>
              <div class="flex flex-wrap gap-2 text-xs">
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">权威信源提及</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">品牌信息矩阵</span>
                <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full">引荐来源建设</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 交付物 + 适用对象 -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <h2 class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span>📦</span> 项目交付物
          </h2>
          <p class="text-slate-500 text-sm mb-6">每个模块都产出可执行、可验证的成果。</p>
          <ul class="space-y-3 list-none pl-0 my-0">
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-emerald-500 mt-0.5">✓</span>
              <span>AI 搜索可见度基线评估报告（固定问题集实测）</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-emerald-500 mt-0.5">✓</span>
              <span>实体与结构化数据部署方案 + 落地实施</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-emerald-500 mt-0.5">✓</span>
              <span>AI 友好内容改造清单（含示例改写）</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-emerald-500 mt-0.5">✓</span>
              <span>品牌信号建设清单与执行排期</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-emerald-500 mt-0.5">✓</span>
              <span>季度 AI 引用变化追踪报告</span>
            </li>
            <li class="flex items-start gap-2 text-slate-600 text-sm">
              <span class="text-emerald-500 mt-0.5">✓</span>
              <span>效果复盘会议：什么在变、为什么、下一步</span>
            </li>
          </ul>
        </div>

        <div class="bg-gradient-to-br from-emerald-50 to-emerald-100/50 rounded-2xl p-8 border border-emerald-200">
          <h2 class="text-2xl font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span>🎯</span> 适合你吗？
          </h2>
          <p class="text-slate-500 text-sm mb-6">以下情况，GEO 优化是高杠杆投入：</p>
          <ul class="space-y-3 list-none pl-0 my-0">
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-6 h-6 bg-emerald-100 text-emerald-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">1</span>
              品牌在 AI 搜索中曝光不足，客户问 AI"推荐谁"时看不到你
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-6 h-6 bg-emerald-100 text-emerald-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">2</span>
              已有 SEO 基础与内容资产，希望升级到 GEO 策略、吃到 AI 流量
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-6 h-6 bg-emerald-100 text-emerald-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">3</span>
              内容型 / B2B 网站，希望内容被 AI 引擎引用为答案来源
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-6 h-6 bg-emerald-100 text-emerald-600 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">4</span>
              行业里 AI 已经开始分流客户，想跑在竞品前面建立先发优势
            </li>
          </ul>
          <p class="text-sm text-slate-500 leading-relaxed mt-6 border-t border-emerald-200 pt-4">
            如果你的网站同时存在传统 SEO 的系统性问题（抓取、收录、内容质量），
            建议先做 <a href="/services/seo-audit/" class="text-emerald-700 font-semibold no-underline hover:underline">SEO 全站诊断</a> 打牢地基，再叠加 GEO。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 如何推进 -->
  <section class="py-20 md:py-28 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 text-center mb-12">项目如何推进</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center relative">
          <div class="w-12 h-12 bg-emerald-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-emerald-600/20">1</div>
          <h4 class="font-bold text-slate-900 mb-2">沟通现状</h4>
          <p class="text-slate-600 text-sm leading-relaxed">15 分钟免费咨询，明确目标与现状，判断 GEO 是否对症</p>
        </div>
        <div class="text-center relative">
          <div class="w-12 h-12 bg-emerald-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-emerald-600/20">2</div>
          <h4 class="font-bold text-slate-900 mb-2">建立基线</h4>
          <p class="text-slate-600 text-sm leading-relaxed">人工审计 / 引擎实测，产出可见度基线与发展路线图</p>
        </div>
        <div class="text-center relative">
          <div class="w-12 h-12 bg-emerald-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg shadow-lg shadow-emerald-600/20">3</div>
          <h4 class="font-bold text-slate-900 mb-2">执行落地</h4>
          <p class="text-slate-600 text-sm leading-relaxed">按路线图分阶段执行：技术、内容、品牌信号逐项落地</p>
        </div>
        <div class="text-center relative">
