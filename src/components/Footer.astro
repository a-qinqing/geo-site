---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 mt-auto">
  <div class="container-page py-12">
    <div class="flex flex-col md:flex-row md:justify-between gap-8">
      <!-- 品牌信息 -->
      <div class="md:max-w-sm">
        <h3 class="text-white font-bold text-lg mb-4">🌐 GEO 咨询</h3>
        <p class="text-slate-400 leading-relaxed">
          专注于 SEO 与 GEO（生成式引擎优化）策略的知识分享与咨询服务，
          帮助企业在 AI 时代获得更多品牌曝光。
        </p>
      </div>

      <!-- 快速链接 -->
      <div class="md:shrink-0">
        <h4 class="text-white font-semibold mb-4">快速链接</h4>
        <ul class="space-y-2 list-none pl-0 my-0">
          <li><a href="/" class="text-slate-400 hover:text-white transition-colors no-underline">首页</a></li>
          <li><a href="/blog" class="text-slate-400 hover:text-white transition-colors no-underline">博客</a></li>
          <li><a href="/about" class="text-slate-400 hover:text-white transition-colors no-underline">关于我</a></li>
          <li><a href="/services" class="text-slate-400 hover:text-white transition-colors no-underline">服务项目</a></li>
          <li><a href="/tool" class="text-slate-400 hover:text-white transition-colors no-underline">工具</a></li>
          <li><a href="/contact" class="text-slate-400 hover:text-white transition-colors no-underline">联系我们</a></li>
        </ul>
      </div>

      <!-- 联系方式 -->
      <div class="md:shrink-0 md:max-w-xs">
        <h4 class="text-white font-semibold mb-4">联系方式</h4>
        <ul class="space-y-2 list-none pl-0 my-0">
          <li class="text-slate-400">📧 contact@geova.cn</li>
          <li class="text-slate-400">📍 在线咨询，服务全球</li>
          <li class="text-slate-400">🕐 工作日 9:00 - 18:00</li>
        </ul>
        <!-- 社交媒体链接 -->
        <div class="mt-6">
          <h4 class="text-white font-semibold mb-3">社交媒体</h4>
          <a
            href="https://www.linkedin.com/in/geova-qin/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors no-underline"
            aria-label="LinkedIn 个人主页"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 版权信息 -->
    <div class="border-t border-slate-800 mt-8 pt-8 text-center text-slate-500 text-sm">
      <p>&copy; {currentYear} GEO 咨询. All rights reserved.</p>
    </div>
  </div>
</footer>
